{
  "expo": {
    "name": "tripautostrade",
    "slug": "tripautostrade",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d9d54cb4-d62a-469e-b5f4-d0a921d29a1f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00695C"
    },
    "ios": {
      "bundleIdentifier": "com.santoromarco74.tripautostrade",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Questa app usa la tua posizione per trovare le aree di servizio vicine."
      }
    },
    "android": {
      "package": "com.santoromarco74.tripautostrade",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDBs2NzQARBAqraqHVNZk1iDFNrpym51gw"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#00695C"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d9d54cb4-d62a-469e-b5f4-d0a921d29a1f"
      }
    },
    "plugins": [
      "expo-font",
      "@sentry/react-native"
    ]
  }
}
